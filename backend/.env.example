# MongoDB Atlas connection string. Leave empty to use the in-memory store (local dev only).
MONGODB_URI=
MONGODB_DB=climate_hazards
# Comma-separated list of allowed browser origins (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only behind a trusted reverse proxy (Render, Cloud Run) so X-Forwarded-For is used for rate limiting.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=60
ANALYSIS_RATE_LIMIT_PER_MINUTE=6
# Optional Open-Meteo commercial API key.
OPEN_METEO_API_KEY=
LOG_LEVEL=INFO
